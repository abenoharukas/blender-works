{
  "name": "blender-works",
  "version": "1.0.0",
  "description": "A procedural Blender model of a high-rise residential complex composed of two independently configured apartment towers, a continuous curved glass podium, open pilotis levels, sky gardens, and landscaped roofs. The project explores facade rhythm, public space, structure, and lighting at the scale of a dense vertical development.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "serve": "python3 -m http.server 8123",
    "plateau:build": "node plateau/scripts/build_plateau_tokyo.mjs",
    "optimize:web": "gltf-transform optimize",
    "rt:build": "bun /Users/raku/repos/others/ThreeRT/renderer/build.ts",
    "rt:bundle": "node /Users/raku/repos/others/ThreeRT/tools/bundle-game.ts streets/native/playground-street.ts -o streets/native/out/playground-street.js",
    "rt:play": "npm run rt:bundle && /Users/raku/repos/others/ThreeRT/renderer/target/release/threert-render play streets/native/out/playground-street.js --assets /Users/raku/repos/others/ThreeRT",
    "rt:diamond:bundle": "node /Users/raku/repos/others/ThreeRT/tools/bundle-game.ts optics/diamond/diamond-optics.ts -o optics/diamond/out/diamond-optics.js",
    "rt:diamond": "node optics/diamond/render-diamond.mjs",
    "rt:diamond:render": "node optics/diamond/render-diamond.mjs",
    "rt:prism:bundle": "node /Users/raku/repos/others/ThreeRT/tools/bundle-game.ts optics/prism/prism-optics.ts -o optics/prism/out/prism-optics.js",
    "rt:prism": "node optics/prism/render-prism.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abenoharukas/blender-works.git"
  },
